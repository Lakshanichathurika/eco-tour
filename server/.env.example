PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/eco_itinerary
CORS_ORIGIN=http://localhost:5173
# Public base URL of this backend, used to build absolute destination image
# URLs. Recommended to set explicitly in production (e.g. Render) rather than
# relying on the request-derived fallback. Leave unset for local dev.
# Example: BACKEND_BASE_URL=https://eco-tour.onrender.com
BACKEND_BASE_URL=
OPENWEATHER_API_KEY=
GOOGLE_PLACES_API_KEY=
# Secret used to sign/verify JWT auth tokens. Must be a long random string —
# generate one yourself (e.g. `openssl rand -hex 32`) and never commit the
# real value.
JWT_SECRET=
